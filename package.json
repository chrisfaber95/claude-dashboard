{
  "name": "claude-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:js": "esbuild src/client/app.ts src/client/login.ts src/client/pair.ts src/client/boot.ts --bundle --outdir=public --target=es2022 --sourcemap",
    "build:css": "sass --no-source-map src/client/style.scss public/style.css",
    "build:html": "node scripts/copy-html.mjs",
    "build": "npm run build:js && npm run build:css && npm run build:html",
    "start": "npm run build && node src/server/server.ts",
    "start:lan": "npm run build && node src/server/server.ts --lan",
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "qrcode-generator": "^2.0.4",
    "sass": "^1.89.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1"
  }
}
